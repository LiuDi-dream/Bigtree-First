# ==================== LLM 配置 ====================
# 支持的提供商: github, openai, nvidia, custom, local
# 选择要使用的提供商
LLM_PROVIDER=github

# 模型名称 (根据提供商调整)
MODEL_NAME=gpt-4o-mini

# --- GitHub 模型配置 ---
# 当 LLM_PROVIDER=github 时使用
GITHUB_TOKEN=
# --- OpenAI 配置 ---
# 当 LLM_PROVIDER=openai 时使用
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- nVidia 配置 ---
# 当 LLM_PROVIDER=nvidia 时使用
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- 通用自定义配置 (如交大API或其他兼容OpenAI的服务) ---
# 当 LLM_PROVIDER=custom 时使用
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# --- 本地模型配置 ---
# 当 LLM_PROVIDER=local 时使用
# 本地模型通常不需要 API Key (会自动设为 "local")
# 需要先启动本地模型服务 (如 ollama、vLLM 等)
LOCAL_BASE_URL=

# ==================== 飞书配置 ====================
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
